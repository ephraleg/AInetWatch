# Generated pipeline output — re-created on every run
data/raw-discovery.json
data/filtered-discovery.json

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Atomic-write temp files (server.py writes these before os.replace())
*.tmp

# OS cruft
.DS_Store

# Editor swap/backup files
*.swp
*~

# Live runtime state belongs outside Git in $AINWA_DATA_DIR.
state/
logs/
backups/
locks/
